# =============================================================================
# Supabase
# =============================================================================
# Supabase 대시보드 > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxx.supabase.co"

# 새 키 체계를 쓰는 프로젝트면 PUBLISHABLE_KEY(sb_publishable_...),
# 기존 프로젝트면 ANON_KEY(eyJ...) 를 넣는다. 둘 중 하나만 있으면 된다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# =============================================================================
# Database (Prisma)
# =============================================================================
# Supabase 대시보드 > Connect > ORMs > Prisma 에서 복사
#
# DATABASE_URL   : 앱이 쓰는 커넥션. 반드시 pooler(포트 6543) + pgbouncer=true
# DIRECT_URL     : 마이그레이션용 직접 연결(포트 5432)
#
# [YOUR-PASSWORD] 자리에 DB 비밀번호를 넣는다. 비밀번호에 특수문자가 있으면
# URL 인코딩이 필요하다 (예: @ -> %40)
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# =============================================================================
# 배포
# =============================================================================
# 배포 도메인 (초대 링크 생성 등에 사용). 로컬은 비워둬도 된다.
# NEXT_PUBLIC_SITE_URL="https://moneybook.vercel.app"

# =============================================================================
# 웹푸시 (VAPID) — `npx web-push generate-vapid-keys` 로 생성
# =============================================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY="B..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:you@example.com"

# =============================================================================
# 크론 인증 — 아무 랜덤 문자열. Vercel 이 크론 호출 시 Bearer 로 보낸다
# =============================================================================
CRON_SECRET="..."
